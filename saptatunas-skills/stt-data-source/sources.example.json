{
  "_petunjuk": "Salin ke ~/stt-data/sources.json lalu ganti base_url, path, dan map sesuai API internal Sapta Tunas. Token disimpan di environment variable, bukan di file ini.",
  "gateway": {
    "base_url": "https://api-gateway.saptatunas.com",
    "auth": { "type": "bearer", "token_env": "STT_API_TOKEN" },
    "headers": {},
    "timeout": 30
  },
  "sources": {
    "pelanggan": {
      "description": "Data pelanggan/klien (CRM) - cari PIC, kontrak, SLA",
      "method": "GET",
      "path": "/crm/v1/customers",
      "params": { "limit": 100 },
      "items_path": "data",
      "pagination": { "type": "page", "param": "page", "start": 1, "max_pages": 5 },
      "map": {
        "timestamp": "updated_at",
        "sender": "name",
        "text": "notes",
        "ref_id": "id",
        "status": "sla_level",
        "email": "email",
        "pic_internal": "account_manager.name"
      }
    },
    "tiket": {
      "description": "Riwayat tiket helpdesk (untuk cari kasus serupa & laporan helpdesk)",
      "method": "GET",
      "path": "/helpdesk/v1/tickets",
      "params": { "limit": 100 },
      "items_path": "data",
      "pagination": { "type": "cursor", "param": "cursor", "next_path": "meta.next_cursor", "max_pages": 10 },
      "map": {
        "timestamp": "created_at",
        "sender": "customer.name",
        "text": "subject",
        "ref_id": "number",
        "status": "status",
        "prioritas": "priority",
        "solusi": "resolution",
        "url": "web_url"
      }
    },
    "tugas_proyek": {
      "description": "Task proyek dari aplikasi project management (untuk laporan proyek)",
      "method": "GET",
      "path": "/pm/v1/projects/{project_id}/tasks",
      "items_path": "items",
      "pagination": { "type": "offset", "param": "offset", "size": 100, "max_pages": 10 },
      "map": {
        "timestamp": "updated_at",
        "sender": "assignee.name",
        "text": "title",
        "ref_id": "id",
        "status": "status",
        "progres": "progress_percent",
        "tenggat": "due_date"
      }
    },
    "template_laporan": {
      "description": "Daftar template dokumen resmi di aplikasi internal",
      "method": "GET",
      "path": "/dms/v1/templates",
      "items_path": "data",
      "map": { "timestamp": "updated_at", "text": "name", "ref_id": "id", "url": "download_url" }
    },
    "buat_tiket": {
      "description": "Membuat tiket helpdesk baru",
      "method": "POST",
      "path": "/helpdesk/v1/tickets",
      "write": true
    },
    "update_tiket": {
      "description": "Update status/catatan tiket",
      "method": "PATCH",
      "path": "/helpdesk/v1/tickets/{ticket_id}",
      "write": true
    }
  }
}
